From e0f9dfc849ec3e7bdf416cc242ef98083656e12a Mon Sep 17 00:00:00 2001
From: Andreas Scherer <andreas_github@freenet.de>
Date: Tue, 19 May 2026 20:03:58 +0200
Subject: [PATCH 70/73] Compile multiply with C++23.

---
 PROTOTYPES/multiply.ch | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

diff --git a/PROTOTYPES/multiply.ch b/PROTOTYPES/multiply.ch
index f9a00fc..734aa87 100644
--- a/PROTOTYPES/multiply.ch
+++ b/PROTOTYPES/multiply.ch
@@ -15,6 +15,14 @@ int main(
   char *argv[]) /* an array of strings containing those arguments */
 @z
 
+@x [5] l.96
+register char *p,*q,*r; /* pointers for string manipulation */
+register long a,b; /* amounts being carried over while doing radix conversion */
+@y
+char *p,*q,*r; /* pointers for string manipulation */
+long a,b; /* amounts being carried over while doing radix conversion */
+@z
+
 @x [7] l.117
 @d retry(s,t)
     {@+printf(s);@+goto t;@+}
@@ -29,7 +37,7 @@ strcpy(x,p);
 strcpy(x,p);@+strcpy(z,x);
 decimal_to_binary(z,buffer,m);
 if (*z) {
-  sprintf(buffer,"(Sorry, %s has more than %ld bits.)\n",x,m);
+  snprintf(buffer,2000,"(Sorry, %s has more than %ld bits.)\n",x,m);
   retry(buffer,step1);
 }
 @z
@@ -40,7 +48,7 @@ strcpy(y,p);
 strcpy(y,p);@+strcpy(z,y);
 decimal_to_binary(z,buffer+m,n);
 if (*z) {
-  sprintf(buffer+m,"(Sorry, %s has more than %ld bits.)\n\n",y,n);
+  snprintf(buffer+m,2000-m,"(Sorry, %s has more than %ld bits.)\n\n",y,n);
   retry(buffer+m,step2);
 }
 @z
@@ -56,11 +64,17 @@ decimal_to_binary(x,s,n)
   char *x; /* decimal string */
   char *s; /* binary string */
   long n; /* length of |s| */
+{@+register long k;
+  register char *p,*q; /* pointers for string manipulation */
+  register long r; /* remainder */
 @y
 void decimal_to_binary(
   char *x, /* decimal string */
   char *s, /* binary string */
   long n) /* length of |s| */
+{@+long k;
+  char *p,*q; /* pointers for string manipulation */
+  long r; /* remainder */
 @z
 
 @x [11] l.227
@@ -82,7 +96,11 @@ if (*z) {
 @x [13] l.282
 long depth(g)
   Graph *g; /* graph with gates as vertices */
+{@+register Vertex *v; /* the current vertex of interest */
+  register Arc *a; /* the current arc of interest */
 @y
 long depth(
   Graph *g) /* graph with gates as vertices */
+{@+Vertex *v; /* the current vertex of interest */
+  Arc *a; /* the current arc of interest */
 @z
